{
  "manifest_version": 3,
  "name": "シート帳へ送る",
  "version": "0.4.0",
  "description": "いあきゃら・キャラッシュ・vinsanet・ゆとシート・キャラクター保管所などのシートを、キャラクターシート帳へ取り込める形でコピーします。",
  "action": {
    "default_title": "シート帳へ送る",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "clipboardRead", "clipboardWrite", "storage"]
}
