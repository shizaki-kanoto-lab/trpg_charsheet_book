{
  "manifest_version": 3,
  "name": "シート帳へ送る",
  "version": "0.7.0",
  "description": "いあきゃら・キャラッシュ・vinsanet・ゆとシート・キャラクター保管所・キャラクターシート倉庫などのシートを、Notionのキャラクターシート帳へ追加します。",
  "action": {
    "default_title": "シート帳へ送る",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "clipboardRead", "storage"],
  "host_permissions": ["https://api.notion.com/*"]
}
